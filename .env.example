# Postgres connection string.
# IMPORTANT: use the Supabase *Session* pooler (port 5432), NOT the Transaction
# pooler (port 6543) — transaction mode breaks prepared statements and Drizzle
# fails at runtime in confusing ways.
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URI=

# Long random string used by Payload to encrypt sessions and API keys.
# Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=

# Supabase Storage, S3-compatible credentials (Storage settings -> S3 Connection).
# When S3_BUCKET is empty, uploads fall back to local disk (local dev only) —
# always set all five in deployed environments.

# Name of the Supabase Storage bucket that holds media uploads.
S3_BUCKET=

# Region shown in Supabase Storage's S3 connection settings, e.g. us-east-1.
S3_REGION=

# S3 endpoint, e.g. https://[project-ref].storage.supabase.co/storage/v1/s3
S3_ENDPOINT=

# S3 access key ID from Supabase Storage settings.
S3_ACCESS_KEY_ID=

# S3 secret access key from Supabase Storage settings.
S3_SECRET_ACCESS_KEY=

# Public R2 (or other CDN) origin for landing media. No trailing slash.
# Hero video: ${NEXT_PUBLIC_MEDIA_URL}/renson-showcase-hd-1.mp4
NEXT_PUBLIC_MEDIA_URL=
